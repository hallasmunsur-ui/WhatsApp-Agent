# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Approved WhatsApp message template used for broadcasts / first-contact messages
WHATSAPP_TEMPLATE_NAME=general_update
WHATSAPP_TEMPLATE_LANG=bn

# AI (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Voice transcription (Groq, OpenAI-compatible) — used for WhatsApp voice notes
GROQ_API_KEY=your-groq-api-key
